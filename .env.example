# --- Tool execution mode ---
# true  = return mock results (no binaries needed, good for local dev + demo)
# false = shell out to real binaries (httpx, wafw00f, whatweb, etc. must be on PATH)
TOOL_MOCK_MODE=true

# --- Ollama LLM endpoint ---
# If your mentor provides a shared remote Ollama instance, set OLLAMA_BASE_URL
# to their host URL.  For local Ollama, leave the default.
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Ollama model name ---
# Must be a model you have pulled: ollama pull llama3
# Other options: qwen2.5, mistral, phi3
OLLAMA_MODEL=llama3
